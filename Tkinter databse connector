from tkinter import *
import mysql.connector
con = mysql.connector.connect(
    host="localhost",
    user="root",
    password="root",
    database="satya"
)
cur=con.cursor()
def add():
    cur.execute("insert into nani(name,mark)values(%s,%s)",(e1.get(),e2.get()))
    con.commit()
    e1.delete(0,END)
    e2.delete(0,END)
def avg():
    cur.execute("select avg(mark) from nani")
    a=cur.fetchone()
    l4.config(text="average=%.2f"%a[0])

root=Tk()
root.geometry("500x500")
root.title("STUDENT MARKS")
Label(root,text="Name").pack()
e1=Entry(root)
e1.pack()
Label(root,text="mark").pack()
e2=Entry(root)
e2.pack()
Button(root,text="ADD",command=add).pack()
Button(root,text="SHOW AVG",command=avg).pack()
l4=Label(root,text="")
l4.pack(pady=10)
root.mainloop()
con.close()
